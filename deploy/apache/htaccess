# MeshAddon configurator on Apache (copy to <dir>/.htaccess next to index.html).
# deploy.sh replaces __INLINE_SCRIPT_HASH__ with the sha256 of index.html's inline <script>.
DirectoryIndex index.html
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.cache(/|$) - [F]
    RewriteRule ^mc/(.*)$ mc.php?p=$1 [QSA,L]
</IfModule>
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self' '__INLINE_SCRIPT_HASH__'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "serial=(self), usb=(), camera=(), microphone=(), geolocation=()"
    <FilesMatch "\.(html|js|json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
